Options -Indexes

# The app shell and its config must always be re-checked, so updates reach
# home-screen installs on the next launch. Audio and icons may cache for a year.
<FilesMatch "^(index\.html|config\.js)$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
<FilesMatch "\.(png|mp3)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
